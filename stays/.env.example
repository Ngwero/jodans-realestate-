PORT=4000
# Optional: restrict API browser origins to the frontend origin.
WEB_ORIGIN=http://localhost:5173

# Public frontend settings. Rebuild after changing VITE_ variables.
# Leave VITE_API_URL empty locally to use Vite's /api proxy.
VITE_API_URL=
VITE_PLATFORM_URL=http://127.0.0.1:8080/home.html
# Optional; defaults to the current frontend origin.
VITE_HOMES_URL=
VITE_SUPABASE_URL=https://cuoudvxhmwteqtqqoqpv.supabase.co
# Supabase publishable key (sb_publishable_...) or legacy anon key.
VITE_SUPABASE_ANON_KEY=

# Server only: use a fresh secret key, never a VITE_ variable.
SUPABASE_URL=https://cuoudvxhmwteqtqqoqpv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Used once by npm run migrate:supabase; remove password after import.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_PASSWORD=
