PORT=4000
# Optional: restrict API browser origins to the frontend origin.
WEB_ORIGIN=http://localhost:5173

# Public frontend settings. Rebuild after changing VITE_ variables.
# Leave VITE_API_URL empty locally to use Vite's /api proxy.
VITE_API_URL=
VITE_PLATFORM_URL=
# Optional; defaults to the current frontend origin.
VITE_HOMES_URL=

# Existing app login. Generate once with: openssl rand -hex 32
JB_SECRET=
# Set to the secret used for existing local SHA-256 password hashes.
# The original development app used this value; omit for a fresh installation.
LEGACY_JB_SECRET=jodans-bloka-dev-secret

# Server only: use a fresh secret key, never a VITE_ variable.
SUPABASE_URL=https://rlorwugbtbfivbqjxyrl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Only required if importing seed data without an existing local admin.
# Remove the bootstrap password after import.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_PASSWORD=
